# Discord Bot Configuration
# Copy this file to .env and fill in your actual values

# ===== REQUIRED SETTINGS =====
# Your Discord bot token from Discord Developer Portal
DISCORD_TOKEN=your_bot_token_here

# Your bot's client ID from Discord Developer Portal
CLIENT_ID=your_client_id_here

# Your Discord server (guild) ID
GUILD_ID=your_guild_id_here

# ===== LOGGING CHANNELS =====
# Channel ID where general bot logs will be sent (voice activity, member joins, etc.)
LOG_CHANNEL_ID=your_log_channel_id_here

# Channel ID where role grant/remove logs will be sent (optional, uses LOG_CHANNEL_ID if not set)
ROLE_LOG_CHANNEL_ID=your_role_log_channel_id_here

# Channel ID where deleted messages will be logged (optional)
DELETED_MESSAGES_LOG_CHANNEL_ID=your_deleted_messages_log_channel_id_here

# ===== OWNER & ADMIN =====
# Owner user ID (receives DM forwards from messageCreate event)
OWNER_ID=your_user_id_here

# ===== WELCOME SYSTEM =====
# Channel ID where welcome messages will be sent
WELCOME_CHANNEL_ID=your_welcome_channel_id_here

# Background image URL for welcome cards (supports GIF/PNG/JPG)
WELCOME_BG_URL=https://i.postimg.cc/your-image-url.gif

# Rules channel ID (mentioned in welcome messages)
RULES_CHANNEL_ID=your_rules_channel_id_here
